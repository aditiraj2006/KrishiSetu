# ─────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────
# DEPLOYMENT NOTE:
# After deploying to production, you MUST add your domain to
# Firebase Authorized Domains to enable OAuth login.
#
# Steps:
#   1. Go to https://console.firebase.google.com
#   2. Authentication → Settings → Authorized Domains
#   3. Click "Add Domain" → enter your production domain
#      e.g., your-app.onrender.com
#   4. Save and test OAuth login on production
#
# NOTE: localhost is authorized by default (development only)
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=test
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=test-app-id

MONGODB_URI=mongodb://127.0.0.1:27017/krishisetu
MONGO_DB_NAME=krishisetu

GOOGLE_GEMINI_API_KEY=test

# ─────────────────────────────────────────────
# Google Gemini API
# ────────────────────────────────────────────