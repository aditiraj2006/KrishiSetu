# ─────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────
# DEPLOYMENT NOTE:
# After deploying to production, you MUST add your domain to
# Firebase Authorized Domains to enable OAuth login.
#
# Steps:
#   1. Go to https://console.firebase.google.com
#   2. Authentication → Settings → Authorized Domains
#   3. Click "Add Domain" → enter your production domain
#      e.g., your-app.onrender.com
#   4. Save and test OAuth login on production
#
# NOTE: localhost is authorized by default (development only)
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here

# ─────────────────────────────────────────────
# MongoDB Connection
# ─────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string_here
MONGO_DB_NAME=mongo_db_name_here

# ─────────────────────────────────────────────
# Google Gemini API
# ─────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
