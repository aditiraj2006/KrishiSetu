# ─────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────
# DEPLOYMENT NOTE:
# After deploying to production, you MUST add your domain to
# Firebase Authorized Domains to enable OAuth login.
#
# Steps:
#   1. Go to https://console.firebase.google.com
#   2. Authentication → Settings → Authorized Domains
#   3. Click "Add Domain" → enter your production domain
#      e.g., your-app.onrender.com
#   4. Save and test OAuth login on production
#
# NOTE: localhost is authorized by default (development only)
# ─────────────────────────────────────────────
# ─────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# ─────────────────────────────────────────────
# MongoDB Connection
# ─────────────────────────────────────────────
MONGODB_URI=YOUR_MONGODB_URI
MONGO_DB_NAME=YOUR_DATABASE_NAME

# ─────────────────────────────────────────────
# Google Gemini API
# ─────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─────────────────────────────────────────────
# OpenWeatherMap API (Real-Time Weather & Crop Advisory)
# ─────────────────────────────────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
VITE_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
